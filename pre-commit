#!/bin/bash

# 阻止将带有实际值的 config.ini 提交到仓库。
# scripts/config.ini 应为未跟踪的本地配置；本 Hook 是额外保护层。

set -u
has_sensitive_config=false

while IFS= read -r file; do
    case "$file" in
        *config.ini)
            staged_content=$(git show ":$file" 2>/dev/null || true)
            if printf '%s\n' "$staged_content" | grep -Eq '^[[:space:]]*[[:alnum:]_]+[[:space:]]*=[[:space:]]*[^[:space:]#]'; then
                echo "错误：暂存的 $file 包含配置值，已阻止提交。"
                echo "请将真实配置保留在未跟踪的 scripts/config.ini 中，并只提交 config.example.ini。"
                has_sensitive_config=true
            fi
            ;;
    esac
done < <(git diff --cached --name-only)

if [ "$has_sensitive_config" = true ]; then
    exit 1
fi

exit 0
